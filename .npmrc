save-exact = true

; The @rtcamp/* packages are public on the npm registry, so no scope registry or
; token is needed.

; Some toolchain packages still declare older peers (e.g. @babel/eslint-parser wants
; eslint ^9, @react-spring wants react ^18) while this skeleton pins eslint 10 and
; react 19; tolerate the peer mismatch rather than force-downgrade.
legacy-peer-deps = true
