save-exact = true

; The @rtcamp/* packages install straight from the public rtCamp/wp-tooling
; repository (git dependencies in package.json), so no registry, token or SSH key
; is needed. package-lock.json records them as git+ssh URLs, but npm fetches public
; GitHub dependencies as HTTPS tarballs. If the packages are published to npm,
; switch them to version ranges.

; @rtcamp/wp-tooling's peer deps (e.g. eslint ^10) are advisory for this skeleton,
; which pins its own toolchain; tolerate the peer mismatch rather than force-upgrade.
; (Redundant once wp-tooling marks those peers optional — rtCamp/wp-tooling#38.)
legacy-peer-deps = true
