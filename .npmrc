save-exact = true

; @rtcamp/wp-tooling's peer deps (e.g. eslint ^10) are advisory for this skeleton,
; which pins its own toolchain; tolerate the peer mismatch rather than force-upgrade.
; (Redundant once wp-tooling marks those peers optional — rtCamp/wp-tooling#38.)
legacy-peer-deps = true

; @rtcamp/wp-tooling is consumed straight from its GitHub repo (a git dependency
; in package.json) during the pilot, so no private registry is needed here.
; Installing it requires git access to the (private) repo — a GitHub token, which
; CI provides via git's insteadOf credential and org users get from `gh auth`.
; When it ships on the public npm registry, switch the dependency back to a
; version range; it then resolves from registry.npmjs.org with no extra config.
