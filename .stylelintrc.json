{
  "extends": "@rtcamp/stylelint-config",
  "ignoreFiles": [
    "**/*.js",
    "**/*.jsx",
    "**/*.json",
    "**/*.php"
  ],
  "rules": {
    "scss/at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "layer",
          "config",
          "plugin",
          "source",
          "theme",
          "utility",
          "variant",
          "custom-variant",
          "reference"
        ]
      }
    ]
  }
}
