# PHPStan configuration for this features plugin.
#
# Extends the shared rtCamp baseline (level 5, WordPress-aware). The baseline
# already loads the szepeviktor/phpstan-wordpress extension exactly once, so do
# NOT include extension.neon here and do NOT rely on extension-installer for it
# (composer.json ignores it for extension-installer).
includes:
    - vendor/rtcamp/wp-phpstan/phpstan.neon.dist

parameters:
    # The plugin constants (PROJECT_NAME_FEATURES_*) are define()d in the root
    # plugin file, which is not under `paths: inc`. Load it so PHPStan knows them.
    bootstrapFiles:
        - project-name-features.php
    paths:
        - inc
    excludePaths:
        # `assets/build` only exists after a block build; mark optional so PHPStan
        # does not error when it is absent (no blocks, or before the first build).
        - assets/build (?)
        - vendor
        - node_modules
        - tests
